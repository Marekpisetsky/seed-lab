{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://seed-lab.example/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://seed-lab.example/:path*",
      "statusCode": 301
    }
  ]
}
